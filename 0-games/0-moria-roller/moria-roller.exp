#!/usr/bin/expect -f
# Author: Roy Wiseman
# Automated character stat roller for Moria inside a tmux session (Expect / Tcl version)

# Target stat and threshold from arguments
set target_stat "INT"
set target_val "18/20"
set session_name "moria_session"

if {[llength $argv] >= 1} {
    set target_stat [string toupper [lindex $argv 0]]
}
if {[llength $argv] >= 2} {
    set target_val [lindex $argv 1]
}
if {[llength $argv] >= 3} {
    set session_name [lindex $argv 2]
}

# Convert stat string to integer score for robust comparison
proc stat_to_score {val} {
    if {[regexp {18/([0-9]+)} $val -> sub]} {
        scan $sub %d dec_sub
        return [expr {1800 + $dec_sub}]
    } elseif {[regexp {^([0-9]+)$} $val -> num]} {
        scan $num %d dec_num
        return [expr {$dec_num * 100}]
    }
    return 0
}

set target_score [stat_to_score $target_val]
if {$target_score == 0} {
    send_user "Error: Invalid target stat format '$target_val'. Examples: 17, 18, 18/20, 18/50, 18/100\n"
    exit 1
}

# Store log files in ~/.moria-roller to keep syskit clean
set home_dir $env(HOME)
set log_dir [file join $home_dir ".moria-roller"]
catch {file mkdir $log_dir}
set log_path [file join $log_dir "moria-roller.log"]

proc timestamp {} {
    set now [clock seconds]
    set millis [expr {[clock milliseconds] % 1000}]
    return [format "%s_%03d" [clock format $now -format "%Y-%m-%d_%H-%M-%S"] $millis]
}

proc log_message {log_path message} {
    catch {
        set fp [open $log_path "a"]
        puts $fp $message
        close $fp
    } err
    if {$err != ""} {
        send_user "Error writing to log file: $err\n"
    }
}

proc extract_concise_info {pane_output attempt} {
    set concise ""
    set str "N/A"; set int "N/A"; set wis "N/A"
    set dex "N/A"; set con "N/A"; set chr "N/A"
    set age "N/A"; set height "N/A"; set weight "N/A"; set social_class "N/A"

    regexp {Age\s*:\s*(\d+)} $pane_output -> age
    regexp {Height\s*:\s*(\d+)} $pane_output -> height
    regexp {Weight\s*:\s*(\d+)} $pane_output -> weight
    regexp {Social Class\s*:\s*(\d+)} $pane_output -> social_class

    regexp {STR\s*:\s*(\S+)} $pane_output -> str
    regexp {INT\s*:\s*(\S+)} $pane_output -> int
    regexp {WIS\s*:\s*(\S+)} $pane_output -> wis
    regexp {DEX\s*:\s*(\S+)} $pane_output -> dex
    regexp {CON\s*:\s*(\S+)} $pane_output -> con
    regexp {CHR\s*:\s*(\S+)} $pane_output -> chr

    set dt [clock format [clock seconds] -format "%Y-%m-%d_%H-%M-%S"]
    append concise "$dt, Attempt: $attempt\n"
    append concise "Age: $age, Height: $height, Weight: $weight, Social Class: $social_class\n"
    append concise "STR: $str, INT: $int, WIS: $wis, DEX: $dex, CON: $con, CHR: $chr\n"
    return $concise
}

# Verify tmux session exists
if {[catch {exec tmux has-session -t $session_name} err]} {
    send_user "Error: tmux session '$session_name' not found!\n"
    send_user "Please start Moria in tmux first, or use './moria-roller.sh --new':\n"
    send_user "  1) tmux new -s $session_name moria\n"
    send_user "  2) Run Moria and reach the stat rolling screen\n"
    send_user "  3) Detach with Ctrl-b d\n"
    send_user "  4) Run: ./moria-roller.exp $target_stat $target_val\n"
    exit 1
}

send_user "==========================================================\n"
send_user " Moria Stat Roller (Expect / Tcl)\n"
send_user " Session: $session_name\n"
send_user " Target : $target_stat >= $target_val (score: $target_score)\n"
send_user " Log    : $log_path\n"
send_user "==========================================================\n"

set total_attempts 0
set start_time [clock seconds]
set found_stat ""

while {1} {
    incr total_attempts

    # Capture pane output
    if {[catch {exec tmux capture-pane -t $session_name -p} pane_output]} {
        send_user "\nError: Lost connection to tmux session '$session_name'.\n"
        exit 1
    }

    # Verify we are on the rolling screen
    if {![string match "*Hit space to re-roll or ESC to accept*" $pane_output]} {
        send_user "\n[PAUSED] Waiting for Moria stat rolling prompt in '$session_name'...\n"
        sleep 1
        continue
    }

    # Extract target stat
    set current_stat "N/A"
    regexp "$target_stat\\s*:\\s*(\\S+)" $pane_output -> current_stat
    set current_score [stat_to_score $current_stat]

    # Log every roll attempt
    log_message $log_path [extract_concise_info $pane_output $total_attempts]

    # Live console progress
    set elapsed [expr {[clock seconds] - $start_time}]
    set mins [expr {$elapsed / 60}]
    set secs [expr {$elapsed % 60}]
    set time_fmt [format "%02d:%02d" $mins $secs]
    send_user "\r\[ROLLING\] Attempt: $total_attempts | Current $target_stat: $current_stat | Elapsed: $time_fmt"

    # Check if target is achieved
    if {$current_score >= $target_score} {
        set found_stat $current_stat
        # Lock in characteristics with ESC
        exec tmux send-keys -t $session_name Escape

        set success_msg "\n\n==========================================================\n"
        append success_msg " \[SUCCESS\] Found $target_stat = $found_stat on attempt #$total_attempts ($time_fmt)!\n"
        append success_msg " Characteristics locked in with ESC.\n"
        append success_msg " Attach to tmux to play: tmux attach -t $session_name\n"
        append success_msg "==========================================================\n"

        log_message $log_path "[timestamp] Attempt $total_attempts: Target $target_stat=$found_stat found! Locked in with ESC."
        send_user $success_msg
        break
    }

    # Send space to reroll
    exec tmux send-keys -t $session_name " "
    sleep 0.06
}